# ---------------------------------------------------------------------------
# bling-api-v3-auth - variáveis de ambiente
#   cp .env.example .env    (requer: pip install "bling-api-v3-auth[dotenv]")
# Nunca commite o .env: ele contém o client_secret.
# ---------------------------------------------------------------------------

# --- Obrigatórias -------------------------------------------------------------
# Central de Extensões > Área do Integrador > seu aplicativo
BLING_CLIENT_ID=your_client_id
BLING_CLIENT_SECRET=your_client_secret

# --- OAuth (opcionais) --------------------------------------------------------
# O Bling sempre usa o link de redirecionamento cadastrado no app; informe aqui
# apenas se quiser enviá-lo explicitamente na URL de autorização.
# BLING_REDIRECT_URI=https://seu-dominio.com.br/callback

# Envia "enable-jwt: 1" para receber tokens JWT (padrão: true).
# BLING_ENABLE_JWT=true

# Renova o access token N segundos antes de expirar (padrão: 60).
# BLING_REFRESH_SKEW=60

# Timeout das requisições OAuth, em segundos (padrão: 30).
# BLING_TIMEOUT=30

# Endpoints (os padrões são os oficiais; altere apenas para testes/proxy).
# BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
# BLING_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token
# BLING_REVOKE_URL=https://api.bling.com.br/Api/v3/oauth/revoke

# --- Armazenamento dos tokens -------------------------------------------------
# json (padrão) | redis | memory
# BLING_TOKEN_STORAGE=json

# json: caminho do arquivo (padrão: ~/.config/bling_api_v3_auth/credentials.json)
# BLING_TOKEN_FILE=./credential/credentials.json

# redis: requer pip install "bling-api-v3-auth[redis]"
# BLING_REDIS_URL=redis://:senha@localhost:6379/0
# BLING_REDIS_KEY=bling_api_v3_auth:token
